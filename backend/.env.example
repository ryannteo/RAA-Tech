# --- App ---
APP_ENV=development
JUDGE_CONFIDENCE_THRESHOLD=0.75

# --- Dormant Tencent Cloud DB scaffold (unused by the MVP) ---
# PLACEHOLDER: fill these in once the team provisions a Tencent Cloud
# PostgreSQL-compatible instance (TencentDB for PostgreSQL / CynosDB for
# PostgreSQL). Until then the API runs on an in-memory store
# (see app/db/store.py) so nobody is blocked on credentials.
TENCENT_DB_HOST=REPLACE_WITH_TENCENT_DB_HOST
TENCENT_DB_PORT=5432
TENCENT_DB_USER=REPLACE_ME
TENCENT_DB_PASSWORD=REPLACE_ME
TENCENT_DB_NAME=ryde_disputes
TENCENT_DB_SSL=require

# --- Rider Advocate LLM (Driver Advocate and Judge remain stubs) ---
# mock: explicit offline stub. tokenhub: real Tencent Hy3; TokenHub API key required.
# Real-provider errors never fall back to mock. Restart after changing settings.
LLM_PROVIDER=mock
LLM_API_KEY=
# Set LLM_PROVIDER=tokenhub for a live request. No automatic provider fallback.
# International-site Singapore endpoint; match this to the site/region of your API key.
# Optional China-site Guangzhou override: https://tokenhub.tencentmaas.com/v1
LLM_BASE_URL=https://tokenhub-intl.tencentcloudmaas.com/v1
LLM_MODEL=hy3
